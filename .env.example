# URL of the ddns-updater HTTP server (used by the "Force refresh" button).
# With docker-compose this is the service name; standalone it might be http://localhost:8000
DDNS_UPDATER_URL=http://ddns-updater:8000

# Optional HTTP basic auth for the GUI. Strongly recommended when exposing it,
# since the GUI reads and edits provider credentials. Leave unset to disable.
# GUI_USERNAME=admin
# GUI_PASSWORD=change-me

# Where config.json + updates.json live (shared with ddns-updater).
# DATA_DIR=/data

# Port the GUI listens on.
# PORT=8080
