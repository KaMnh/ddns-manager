# URL of the ddns-updater HTTP server (used by the "Force refresh" button).
# With docker-compose this is the service name; standalone it might be http://localhost:8000
DDNS_UPDATER_URL=http://ddns-updater:8000

# Container the "Restart & apply" button restarts, so added/edited/removed records
# take effect (ddns-updater reads config.json only at startup). Requires the Docker
# socket to be reachable — see DOCKER_SOCKET / DOCKER_HOST below.
# Set to an empty value to disable one-click restarts entirely.
DDNS_UPDATER_CONTAINER=ddns-updater

# How to reach the Docker API. Default is the socket, which must be mounted:
#   -v /var/run/docker.sock:/var/run/docker.sock
# DOCKER_SOCKET=/var/run/docker.sock
# Or point at a docker-socket-proxy instead of mounting the socket:
# DOCKER_HOST=tcp://docker-proxy:2375
#
# Seconds ddns-updater gets to stop before Docker kills it during a restart.
# RESTART_STOP_TIMEOUT=10

# Optional HTTP basic auth for the GUI. Strongly recommended when exposing it,
# since the GUI reads and edits provider credentials. Leave unset to disable.
# GUI_USERNAME=admin
# GUI_PASSWORD=change-me

# Where config.json + updates.json live (shared with ddns-updater).
# DATA_DIR=/data

# Port the GUI listens on.
# PORT=8080
